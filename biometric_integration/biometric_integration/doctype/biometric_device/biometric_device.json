{
  "doctype": "DocType",
  "name": "Biometric Device",
  "module": "Biometric Integration",
  "custom": 0,
  "istable": 1,
  "is_child_table": 1,
  "editable_grid": 1,
  "field_order": [
    "device",
    "ip_address",
    "is_active",
    "status",
    "last_status_check",
    "username",
    "password",
    "column_break_location",
    "latitude",
    "longitude",
    "last_error"
  ],
  "fields": [
    {
      "fieldname": "device",
      "label": "Device Name",
      "fieldtype": "Data",
      "in_list_view": 1,
      "reqd": 1
    },
    {
      "fieldname": "ip_address",
      "label": "IP Address",
      "fieldtype": "Data",
      "in_list_view": 1,
      "reqd": 1
    },
    {
      "fieldname": "username",
      "label": "Username",
      "fieldtype": "Data"
    },
    {
      "fieldname": "password",
      "label": "Password",
      "fieldtype": "Password"
    },
    {
      "fieldname": "is_active",
      "label": "Active",
      "fieldtype": "Check",
      "default": "1",
      "in_list_view": 1
    },
    {
      "default": "Unknown",
      "fieldname": "status",
      "fieldtype": "Select",
      "in_list_view": 1,
      "label": "Status",
      "options": "Unknown\nOnline\nOffline\nError",
      "read_only": 1
    },
    {
      "fieldname": "last_status_check",
      "fieldtype": "Datetime",
      "label": "Last Checked",
      "read_only": 1
    },
    {
      "fieldname": "column_break_location",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "latitude",
      "label": "Latitude",
      "fieldtype": "Float",
      "precision": "7",
      "description": "Device location latitude (optional). Used for geolocation tracking if HR Settings > Allow Geolocation Tracking is enabled."
    },
    {
      "fieldname": "longitude",
      "label": "Longitude",
      "fieldtype": "Float",
      "precision": "7",
      "description": "Device location longitude (optional). Used for geolocation tracking if HR Settings > Allow Geolocation Tracking is enabled."
    },
    {
      "fieldname": "last_error",
      "fieldtype": "Small Text",
      "label": "Last Connection Error",
      "read_only": 1
    }
  ],
  "permissions": []
}
